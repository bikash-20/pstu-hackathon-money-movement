# --- Database -------------------------------------------------------------
# Postgres connection string. Local docker-compose ships myuser/mypassword/mydb.
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydb?schema=public"

# --- HTTP -----------------------------------------------------------------
PORT=4000

# --- Security -------------------------------------------------------------
# Comma-separated allow-list. Keep "*" only for local dev / quick demos.
# CORS_ORIGINS=https://frontend-alpha-inky-87.vercel.app
CORS_ORIGINS=*

# When set, POST /api/admin/reset requires header `x-admin-secret: <value>`.
# Leave empty for the open demo behaviour.
ADMIN_SECRET=

# --- Money limits (integer cents; ৳1 = 100 cents) --------------------------
# Per-transfer ceiling.
MAX_TRANSFER_CENTS=5000000
# Daily spend circuit-breaker per user (resets each settlement day).
DAILY_LIMIT_CENTS=20000000
# Business timezone defining a "settlement day" for the daily ceiling.
WALLET_TIMEZONE=Asia/Dhaka

# --- External-payments v3 ------------------------------------------------
# Add-Money daily cap (independent from the out-spend ceiling so generous
# top-ups don't conflict with the daily spend circuit-breaker).
FUNDING_DAILY_LIMIT_CENTS=50000000
# FX rates: BDT per 1 unit of foreign currency. Used by /api/fx/transfer.
FX_USD_BDT=110.00
FX_EUR_BDT=120.00
FX_GBP_BDT=140.00
FX_INR_BDT=1.32
